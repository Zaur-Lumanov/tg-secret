{
  "compilerOptions": {
    "target": "ES2023",
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "sourceMap": true,
    "types": ["node"],
    // in development tg-secret-core resolves to its TypeScript sources (see its "exports")
    "customConditions": ["tg-secret-source"]
  }
}
